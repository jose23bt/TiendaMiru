rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios - Solo el dueño puede leer/escribir
    match /usuarios/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Pedidos - Cada cliente lee SOLO los suyos. Nadie los cambia desde el navegador:
    // el admin los lista y actualiza con las funciones adminListarPedidos / adminActualizarPedido (con su contraseña).
    // Antes cualquier sesión (incluso anónima) podía leer y modificar los pedidos de todos los clientes.
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && (!('uid' in request.resource.data) || request.resource.data.uid == null || request.resource.data.uid == request.auth.uid)
        && request.resource.data.estado == 'pendiente';
      allow update, delete: if false;
    }
    
    // Productos - Lectura PÚBLICA
    match /productos/{productoId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Secciones - Lectura PÚBLICA
    match /secciones/{seccionId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ComidaLista - Lectura PÚBLICA (IMPORTANTE)
    match /comidaLista/{comidaId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Comidas - Lectura PÚBLICA
    match /comidas/{comidaId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Config - Lectura PÚBLICA
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default - Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
