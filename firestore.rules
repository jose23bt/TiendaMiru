rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── PRODUCTOS ───
    // Lectura pública (la tienda los necesita)
    // Escritura SOLO desde Cloud Functions (admin SDK bypasea reglas)
    match /productos/{productoId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── CONFIG ───
    match /config/tienda {
      // Lectura pública (nombre, WA, mensaje)
      allow read: if true;
      allow write: if false;
    }

    match /config/seguridad {
      // BLOQUEADO — solo accesible desde Cloud Functions (admin SDK)
      allow read: if false;
      allow write: if false;
    }

    match /config/sesiones {
      // BLOQUEADO — solo accesible desde Cloud Functions (admin SDK)
      allow read: if false;
      allow write: if false;
    }

    match /config/loginAttempts {
      // BLOQUEADO — rate limiting, solo Cloud Functions (admin SDK)
      allow read: if false;
      allow write: if false;
    }

    // Bloquear cualquier otro documento en config
    match /config/{doc} {
      allow read: if false;
      allow write: if false;
    }

    // ─── CATCH-ALL ───
    // Bloquear todo lo demás por defecto
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
