rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios de la web vieja - Solo el dueño los lee o los borra (las cuentas nuevas están en la tienda del gestor)
    match /usuarios/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pedidos - La web ya no toma pedidos (van a la tienda del gestor, tiendamiru.com/pedir).
    // Quedan los viejos; nadie los lee ni los cambia desde el navegador.
    match /pedidos/{pedidoId} {
      allow read, write: if false;
    }
    
    // Productos - Lectura PÚBLICA
    match /productos/{productoId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Secciones - Lectura PÚBLICA
    match /secciones/{seccionId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Productos, secciones, comidaLista y config: solo lectura. El gestor (Tienda online → Página web)
    // los lee una vez para traer las fotos y videos que estaban cargados.
    // ComidaLista - Lectura PÚBLICA
    match /comidaLista/{comidaId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Comidas - Lectura PÚBLICA
    match /comidas/{comidaId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Config - Lectura PÚBLICA
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default - Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
