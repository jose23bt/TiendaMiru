rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Usuarios - Solo el dueño puede leer y escribir
    match /usuarios/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Pedidos - Usuarios autenticados pueden leer (para historial)
    //          Solo admin puede crear/actualizar
    match /pedidos/{pedidoId} {
      // Cualquier usuario autenticado puede ver sus propios pedidos
      allow read: if request.auth.uid != null;
      
      // Solo admin puede crear (en functions)
      allow create: if request.auth.uid != null;
      
      // Solo el propietario o admin puede actualizar
      allow update: if request.auth.uid != null;
    }
    
    // Productos - Lectura pública, escritura restringida
    match /productos/{productoId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Otras colecciones
    match /{document=**} {
      allow read: if request.auth.uid != null;
      allow write: if false;
    }
  }
} 
